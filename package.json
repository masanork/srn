{
  "name": "srn",
  "version": "1.0.0",
  "description": "srn (Short for Sorane) is a Static Site Generator designed for precision and performance in typography.",
  "main": "index.js",
  "engines": {
    "bun": ">= 1.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run build:wasm && bun run build:blog && bun run build:srn",
    "build:wasm": "if command -v wasm-pack >/dev/null; then cd packages/civ && wasm-pack build --target web --out-dir ../../sites/srn/static/wasm/civ; else echo 'wasm-pack not found, skipping WASM build'; fi",
    "build:blog": "bun run src/ssg/index.ts --site my-blog",
    "build:srn": "bun scripts/build_weba_client.ts && rm -rf .cache/plugin-bundles && bun build src/form/browser_maker.ts --outfile sites/srn/static/mkform.js --minify --define \"global=window\" --define \"process=window.process\" --banner=\"window.__WEBA_BUILD_TIME__='$(date -u +%Y-%m-%dT%H:%M:%SZ)';\" && cp src/form/index.html sites/srn/static/maker.html && bun run src/ssg/index.ts --site srn",
    "convert": "bun run src/bin/weba-convert.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:links": "bun test tests/link_integrity.test.ts",
    "migrate:blog": "bun src/ssg/migrate.ts --site my-blog",
    "weba-l2-crypto": "bun src/bin/weba-l2-crypto.ts",
    "weba-verify": "bun src/bin/weba-verify.ts",
    "folio": "bun src/folio/cli.ts",
    "remote:build": "npm --prefix remote/functions run build",
    "remote:deploy": "cd remote && firebase --project=weba-folio-remote deploy --only functions,hosting,firestore",
    "deploy": "bun run deploy:blog && bun run deploy:srn",
    "deploy:blog": "gh-pages -d dist/my-blog -r https://github.com/masanork/masanork.github.io.git -b main",
    "deploy:srn": "gh-pages -d dist/srn"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@types/bun": "latest",
    "@types/fs-extra": "^11.0.4",
    "@types/glob": "^8.1.0",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^20.10.5",
    "gh-pages": "^6.1.1",
    "happy-dom": "^15.7.4",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@apollo/server": "^5.2.0",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.0",
    "@pokusew/pcsclite": "^0.6.0",
    "@srn/core": "workspace:*",
    "apollo-server-cloud-functions": "^3.13.0",
    "asn1js": "^3.0.7",
    "body-parser": "^2.2.1",
    "canonicalize": "^2.0.0",
    "cbor-x": "^1.5.3",
    "cheerio": "1.0.0-rc.12",
    "commander": "^11.1.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "fast-csv": "^4.3.6",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.2",
    "fs-extra": "^11.2.0",
    "glob": "^10.3.10",
    "graphql": "^16.12.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "jsdom": "^27.4.0",
    "markdown-it": "^14.0.0",
    "markdown-it-anchor": "^8.6.7",
    "markdown-it-container": "^4.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-front-matter": "^0.2.3",
    "markdown-it-table-of-contents": "^0.6.0",
    "node-fetch": "^3.3.2",
    "opentype.js": "^1.3.4",
    "pkijs": "^3.3.3",
    "pvutils": "^1.1.5",
    "zod": "^3.22.4"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "trustedDependencies": [
    "@pokusew/pcsclite"
  ]
}