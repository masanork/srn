node_modules
dist
.deploy
.DS_Store
srn.config.yaml

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Shared Assets (Proprietary files should not be committed)
shared/fonts/*
!shared/fonts/.gitkeep
shared/fonts/catalog.html

# Generated Data & Keys
# Each site's data directory (containing root-key.json) must be ignored
sites/*/data/

# Environment
.env

# SSG Content Management
# Ignore all site content by default to prevent leaking private site data
sites/**/content/
sites/**/data/
sites/**/config.yaml
sites/**/static/
!sites/srn/static/

# Explicitly allow srn content (official docs)
!sites/srn/content/
!sites/srn/content/srn.md
!sites/srn/content/blog.md
!sites/srn/content/guide.md
!sites/srn/content/juminhyo.md
!sites/srn/content/verify.md
!sites/srn/content/releases.md
!sites/srn/content/tech-verification.md
!sites/srn/content/variants.md
!sites/srn/content/issues.md
!sites/srn/content/ben.md
!sites/srn/content/sai.md

# Also allow only the official demo site configuration
!sites/srn/config.yaml

# Allow Web/A site
!sites/weba/config.yaml
!sites/weba/content/
!sites/weba/static/
sites/weba/private/
.cache/

# Rust
target/
**/*.rs.bk

# workspace

# Keys
epoch-private.json
**/epoch-private.json
keys/

work/
coverage/
.firebase/

# Build artifacts
remote/functions/lib/
sites/*/static/*.js
!sites/*/static/README.md

# WASM bindings (generated)
src/core/wasm_bindings/

# Rust build
Cargo.lock
**/Cargo.lock

# Folio local data
history/

# Test fixtures
tests/fixtures/*/data/
firebase-debug.log

# Trust Anchors / Certificates
shared/certificates/
**/*.cer
**/*.crt
**/*.pem
**/*.p7b
**/*.mld
**/*.zip

# Postal Data
shared/data/postal/utf_ken_all.csv
shared/data/postal/postal-optimized.json
shared/data/postal/postal-optimized.json.gz
shared/data/postal/postal-optimized.json.br
shared/data/postal/postal-embedded.txt
