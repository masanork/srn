{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/v1/prekey",
        "function": "getPreKey"
      }
    ]
  },
  "functions": [
    {
      "source": "src/tools/prekey-firebase/functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "firestore": {
    "rules": "src/tools/prekey-firebase/firestore.rules"
  }
}
